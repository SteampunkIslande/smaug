#!/usr/bin/env python3
"""Generate a standalone HTML report from a smaug run report database.

The report groups Snakemake jobs by rule. For each rule, it lists the jobs,
their wildcard values and clickable links to the log files served by the smaug
API.

The database is normally generated by smaug next to the run:

    <analysis_dir>/run-<run_id>/smaug-run-report-attempt-<n>.db

The report path is enough to infer the run and the attempt:

    generate-run-report <analysis_dir>/run-00000006/smaug-run-report-attempt-3.db

A run directory can also be given, optionally with `--attempt`:

    generate-run-report <analysis_dir>/run-00000006 --attempt 3
"""

from __future__ import annotations

import argparse
import html
import re
import sqlite3
import sys
from collections import Counter
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from urllib.parse import quote

DEFAULT_API_BASE = "/smaug/files"
REPORT_SCOPE = "run"
RUN_DIR_RE = re.compile(r"^run-(\d+)$")
REPORT_DB_RE = re.compile(r"^smaug-run-report-attempt-(\d+)\.db$")

STATUS_LABELS = {
    "running": "en cours",
    "submitted": "soumis",
    "completed": "terminé",
    "failed": "échec",
    "unknown": "inconnu",
}

KNOWN_STATUSES = frozenset(STATUS_LABELS)


@dataclass(frozen=True)
class Report:
    db_path: Path
    run_dir: Path
    run_id: int
    attempt: int
    api_base: str
    workdirs: tuple[Path, ...]


@dataclass
class RenderContext:
    report: Report
    roots: tuple[Path, ...]
    missing: list[str]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Génère un rapport HTML à partir d'une base de rapport d'exécution "
            "smaug."
        ),
        epilog=(
            "Exemples :\n"
            "  %(prog)s run-00000006/smaug-run-report-attempt-3.db\n"
            "  %(prog)s run-00000006 --attempt 3\n"
            "  %(prog)s run-00000006/smaug-run-report-attempt-3.db -o rapport.html"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "report",
        nargs="?",
        default=".",
        help=(
            "base sqlite du rapport, ou dossier de run contenant "
            "smaug-run-report-attempt-*.db (défaut : dossier courant)"
        ),
    )
    parser.add_argument(
        "--attempt",
        type=int,
        help="tentative à sélectionner lorsque REPORT est un dossier",
    )
    parser.add_argument(
        "--run-dir",
        help=(
            "racine du run, si elle ne peut pas être déduite du chemin de la "
            "base (dossier run-<id>)"
        ),
    )
    parser.add_argument(
        "--workdir",
        action="append",
        default=[],
        metavar="DIR",
        help=(
            "racine supplémentaire pour résoudre les chemins Snakemake "
            "(répétable, ex. <run>/results)"
        ),
    )
    parser.add_argument(
        "--output",
        "-o",
        help="fichier HTML à écrire ; par défaut, à côté de la base",
    )
    parser.add_argument(
        "--api-base",
        default=DEFAULT_API_BASE,
        help=f"préfixe des liens de logs (par défaut : {DEFAULT_API_BASE})",
    )
    return parser.parse_args()


def escape(value: object) -> str:
    return html.escape(str(value), quote=True)


def attempt_from_db(path: Path) -> int | None:
    match = REPORT_DB_RE.fullmatch(path.name)
    return int(match.group(1)) if match else None


def find_run_dir(db_path: Path) -> Path | None:
    for parent in db_path.parents:
        if RUN_DIR_RE.fullmatch(parent.name):
            return parent.resolve()
    return None


def find_report_db(target: Path, attempt: int | None) -> Path:
    target = target.expanduser()

    if target.is_file():
        return target.resolve()

    if not target.is_dir():
        raise FileNotFoundError(f"Chemin introuvable : {target}")

    selected = target / f"smaug-run-report-attempt-{attempt}.db" if attempt else None
    if selected is not None and selected.is_file():
        return selected.resolve()

    candidates = [
        path
        for path in target.glob("smaug-run-report-attempt-*.db")
        if attempt_from_db(path) is not None
    ]

    if not candidates:
        run_dirs = sorted(
            path
            for path in target.iterdir()
            if path.is_dir() and RUN_DIR_RE.fullmatch(path.name)
        )
        if len(run_dirs) == 1:
            return find_report_db(run_dirs[0], attempt)
        raise FileNotFoundError(
            f"Aucune base smaug-run-report-attempt-*.db dans {target}"
        )

    if attempt is None:
        return max(candidates, key=lambda path: attempt_from_db(path) or 0).resolve()

    raise FileNotFoundError(
        f"Rapport de la tentative {attempt} introuvable dans {target}"
    )


def build_report(args: argparse.Namespace) -> Report:
    db_path = find_report_db(Path(args.report), args.attempt)

    run_dir = (
        Path(args.run_dir).expanduser().resolve()
        if args.run_dir
        else find_run_dir(db_path)
    )
    if run_dir is None:
        raise ValueError(
            "Impossible de déduire le dossier du run depuis la base ; "
            "utilisez --run-dir"
        )

    run_match = RUN_DIR_RE.fullmatch(run_dir.name)
    if run_match is None:
        raise ValueError(f"{run_dir} n'est pas un dossier run-<id>")

    attempt = attempt_from_db(db_path)
    if attempt is None:
        raise ValueError(
            f"Nom de base inattendu : {db_path.name} "
            "(attendu : smaug-run-report-attempt-<n>.db)"
        )

    if args.attempt is not None and attempt != args.attempt:
        raise ValueError(
            f"La base {db_path.name} correspond à la tentative {attempt}, "
            f"pas à la tentative {args.attempt}"
        )

    workdirs = tuple(Path(path).expanduser().resolve() for path in args.workdir)

    return Report(
        db_path=db_path,
        run_dir=run_dir,
        run_id=int(run_match.group(1)),
        attempt=attempt,
        api_base=args.api_base.rstrip("/") or DEFAULT_API_BASE,
        workdirs=workdirs,
    )


def search_roots(report: Report) -> tuple[Path, ...]:
    """Directories tried when resolving a path recorded in the database.

    The explicit workdirs come first, then the run directory, then its immediate
    subdirectories. The latter recovers reports written before the report
    database knew Snakemake's actual working directory (for example paths
    recorded as `logs/...` while the file lives in `results/logs/...`).
    """
    roots: list[Path] = [*report.workdirs, report.run_dir]

    try:
        roots.extend(
            sorted(
                path.resolve()
                for path in report.run_dir.iterdir()
                if path.is_dir()
            )
        )
    except OSError:
        pass

    unique: list[Path] = []
    seen: set[Path] = set()
    for root in roots:
        if root not in seen:
            seen.add(root)
            unique.append(root)
    return tuple(unique)


def load_rows(db_path: Path) -> list[sqlite3.Row]:
    uri = f"{db_path.resolve().as_uri()}?mode=ro"
    connection = sqlite3.connect(uri, uri=True)
    connection.row_factory = sqlite3.Row
    try:
        return connection.execute(
            """
            SELECT slurm_job_name, slurm_job_id, snakemake_job_id, rule_name,
                   status, log_paths, wildcards
            FROM snakemake
            ORDER BY rule_name COLLATE NOCASE, snakemake_job_id
            """
        ).fetchall()
    finally:
        connection.close()


def split_values(value: str | None) -> list[str]:
    if not value:
        return []
    return [part.strip() for part in value.split(",") if part.strip()]


def status_of(row: sqlite3.Row) -> str:
    status = (row["status"] or "").strip().lower()
    return status if status in KNOWN_STATUSES else "unknown"


def status_badge(status: str) -> str:
    label = STATUS_LABELS.get(status, STATUS_LABELS["unknown"])
    return f'<span class="status status-{status}">{escape(label)}</span>'


def resolve_log_target(raw_path: str, context: RenderContext) -> Path | None:
    """Find the real file for a path recorded in the report database."""
    raw = Path(raw_path)
    candidates: list[Path] = []

    if raw.is_absolute():
        candidates.append(raw)
        try:
            relative = raw.relative_to(context.report.run_dir)
        except ValueError:
            relative = None
        if relative is not None:
            candidates.extend(root / relative for root in context.roots)
    else:
        candidates.extend(root / raw for root in context.roots)

    for candidate in candidates:
        try:
            if candidate.is_file():
                return candidate.resolve()
        except OSError:
            continue

    return None


def log_href(target: Path, context: RenderContext) -> str | None:
    try:
        relative = target.relative_to(context.report.run_dir)
    except ValueError:
        return None

    relative_str = relative.as_posix()
    if relative_str in ("", "."):
        return None

    return (
        f"{context.report.api_base}/{context.report.run_id}/"
        f"{context.report.attempt}/{REPORT_SCOPE}/"
        f"{quote(relative_str, safe='/')}"
    )


def render_logs(raw_paths: str | None, context: RenderContext) -> str:
    links: list[str] = []

    for raw_path in split_values(raw_paths):
        if "://" in raw_path:
            href = raw_path
            label = raw_path
        else:
            target = resolve_log_target(raw_path, context)
            if target is None:
                context.missing.append(raw_path)
                href = None
                label = raw_path
            else:
                href = log_href(target, context)
                if href is None:
                    context.missing.append(raw_path)
                    label = raw_path
                else:
                    label = target.relative_to(context.report.run_dir).as_posix()

        if href is not None:
            links.append(
                f'<a class="log-link" href="{escape(href)}" target="_blank" '
                f'rel="noopener" title="{escape(raw_path)}">{escape(label)}</a>'
            )
        else:
            links.append(
                f'<span class="log-missing" title="{escape(raw_path)}">'
                f"{escape(label)}</span>"
            )

    if not links:
        return '<span class="muted">—</span>'
    return '<div class="log-list">' + "".join(
        f"<div>{link}</div>" for link in links
    ) + "</div>"


def render_wildcards(raw_wildcards: str | None) -> str:
    values = split_values(raw_wildcards)
    if not values:
        return '<span class="muted">—</span>'
    return " ".join(f'<span class="chip">{escape(value)}</span>' for value in values)


def render_summary(status_counts: Counter[str], total_jobs: int, total_rules: int) -> str:
    badges = [
        f'<span class="summary-badge"><strong>{total_jobs}</strong> job(s)</span>',
        f'<span class="summary-badge"><strong>{total_rules}</strong> règle(s)</span>',
    ]
    for status in ("completed", "failed", "running", "submitted", "unknown"):
        count = status_counts.get(status, 0)
        if count:
            badges.append(
                f'<span class="summary-badge status-{status}">'
                f"<strong>{count}</strong> {escape(STATUS_LABELS[status])}</span>"
            )
    return "".join(badges)


def render_rule_panel(
    name: str,
    panel_id: str,
    jobs: list[sqlite3.Row],
    context: RenderContext,
) -> str:
    status_counts = Counter(status_of(row) for row in jobs)
    summary = (
        f"{len(jobs)} job(s) · {status_counts.get('completed', 0)} terminé(s) · "
        f"{status_counts.get('failed', 0)} en échec"
    )

    rows_html: list[str] = []
    for row in jobs:
        jobid = row["snakemake_job_id"]
        jobid_html = "—" if jobid is None else f"#{jobid}"
        workflow = (row["slurm_job_name"] or "").strip()
        workflow_html = (
            f'<div class="muted small" title="{escape(workflow)}">'
            f"workflow : <code>{escape(workflow)}</code></div>"
            if workflow
            else ""
        )

        slurm_job_id = (row["slurm_job_id"] or "").strip()
        slurm_html = (
            f"<code>{escape(slurm_job_id)}</code>"
            if slurm_job_id
            else '<span class="muted">—</span>'
        )

        rows_html.append(
            "<tr>"
            f'<td><span class="jobid">{escape(jobid_html)}</span>{workflow_html}</td>'
            f"<td>{status_badge(status_of(row))}</td>"
            f"<td>{slurm_html}</td>"
            f"<td>{render_wildcards(row['wildcards'])}</td>"
            f"<td>{render_logs(row['log_paths'], context)}</td>"
            "</tr>"
        )

    return f"""
      <section class="rule-panel" id="{panel_id}">
        <div class="panel-head">
          <div>
            <h2>{escape(name)}</h2>
            <p class="muted">{escape(summary)}</p>
          </div>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Job</th>
                <th>Statut</th>
                <th>Slurm</th>
                <th>Wildcards</th>
                <th>Logs</th>
              </tr>
            </thead>
            <tbody>
              {''.join(rows_html)}
            </tbody>
          </table>
        </div>
      </section>
    """


