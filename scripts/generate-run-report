SCRIPT = """
    (() => {
      const buttons = Array.from(document.querySelectorAll(".rule-button"));
      const panels = Array.from(document.querySelectorAll(".rule-panel"));
      const search = document.getElementById("rule-search");
      const noMatch = document.getElementById("no-match");

      const activate = (target) => {
        for (const button of buttons) {
          button.classList.toggle("active", button.dataset.target === target);
        }
        for (const panel of panels) {
          panel.classList.toggle("active", panel.id === target);
        }
      };

      for (const button of buttons) {
        button.addEventListener("click", () => activate(button.dataset.target));
      }

      search.addEventListener("input", () => {
        const term = search.value.trim().toLocaleLowerCase();
        for (const button of buttons) {
          const name = button.dataset.name || "";
          button.hidden = Boolean(term) && !name.includes(term);
        }

        const visible = buttons.filter((button) => !button.hidden);
        noMatch.hidden = visible.length > 0;

        if (visible.length === 0) {
          for (const button of buttons) button.classList.remove("active");
          for (const panel of panels) panel.classList.remove("active");
          return;
        }

        if (!visible.some((button) => button.classList.contains("active"))) {
          activate(visible[0].dataset.target);
        }
      });

      if (buttons.length > 0) activate(buttons[0].dataset.target);
    })();
"""


def build_html(rows: list[sqlite3.Row], context: RenderContext) -> str:
    rules: dict[str, list[sqlite3.Row]] = {}
    for row in rows:
        name = (row["rule_name"] or "").strip() or "(règle inconnue)"
        rules.setdefault(name, []).append(row)

    rule_names = sorted(
        rules,
        key=lambda name: (name.startswith("("), name.casefold()),
    )

    status_counts: Counter[str] = Counter(status_of(row) for row in rows)
    total_jobs = len(rows)
    total_rules = len(rule_names)

    buttons: list[str] = []
    panels: list[str] = []

    for index, name in enumerate(rule_names):
        jobs = sorted(
            rules[name],
            key=lambda row: (
                (row["slurm_job_name"] or ""),
                row["snakemake_job_id"]
                if row["snakemake_job_id"] is not None
                else -1,
            ),
        )
        panel_id = f"rule-{index}"
        failed = sum(1 for row in jobs if status_of(row) == "failed")
        failure_marker = (
            f'<span class="fail-dot" title="{failed} job(s) en échec">●</span>'
            if failed
            else ""
        )

        buttons.append(
            f'<button class="rule-button" type="button" data-target="{panel_id}" '
            f'data-name="{escape(name.lower())}">'
            f'<span class="rule-name">{escape(name)}</span>'
            f'<span class="rule-meta"><span class="count">{len(jobs)}</span>'
            f"{failure_marker}</span></button>"
        )
        panels.append(render_rule_panel(name, panel_id, jobs, context))

    if buttons:
        sidebar_rules = "\n".join(buttons)
        main_content = "\n".join(panels)
    else:
        sidebar_rules = ""
        main_content = """
        <section class="rule-panel active">
          <div class="empty-state">
            <h2>Aucun job enregistré</h2>
            <p class="muted">La table <code>snakemake</code> de ce rapport est vide.</p>
          </div>
        </section>
        """

    generated_at = datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")
    summary = render_summary(status_counts, total_jobs, total_rules)

    missing_note = (
        f'<p class="muted small">{len(context.missing)} chemin(s) de log '
        "non serviable(s) (fichier absent ou hors du dossier du run) : "
        "ils sont affichés sans lien.</p>"
        if context.missing
        else ""
    )

    report = context.report
    run_id = report.run_id
    attempt = report.attempt
    run_dir = report.run_dir
    db_path = report.db_path

    return f"""<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Rapport d'exécution — run {run_id}, tentative {attempt}</title>
  <style>{STYLE}</style>
</head>
<body>
  <header class="topbar">
    <div>
      <h1>Rapport d'exécution</h1>
      <p class="subtitle">Run {run_id} · tentative {attempt} · {escape(run_dir)}</p>
    </div>
    <div class="summary">{summary}</div>
  </header>

  <div class="layout">
    <aside class="sidebar">
      <div class="search">
        <label for="rule-search">Règles</label>
        <input id="rule-search" type="search" placeholder="Rechercher une règle…" autocomplete="off">
      </div>
      <nav id="rules" aria-label="Règles">
        {sidebar_rules}
      </nav>
      <p id="no-match" class="muted small" hidden>Aucune règle ne correspond.</p>
    </aside>

    <main id="content">
      {main_content}
    </main>
  </div>

  <footer class="footer">
    <p>Généré le {escape(generated_at)} depuis <code>{escape(db_path)}</code>.</p>
    {missing_note}
  </footer>

  <script>{SCRIPT}</script>
</body>
</html>
"""


def main() -> int:
    args = parse_args()

    try:
        report = build_report(args)
        rows = load_rows(report.db_path)
    except (FileNotFoundError, ValueError, sqlite3.Error) as exc:
        print(f"Erreur : {exc}", file=sys.stderr)
        return 2

    context = RenderContext(
        report=report,
        roots=search_roots(report),
        missing=[],
    )
    document = build_html(rows, context)

    output = (
        Path(args.output).expanduser()
        if args.output
        else report.db_path.with_suffix(".html")
    )
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(document, encoding="utf-8")
    print(f"Rapport écrit dans {output}")

    if context.missing:
        print(
            f"Attention : {len(context.missing)} chemin(s) de log non serviable(s) "
            "(fichier absent ou hors du dossier du run) ; "
            "ils sont affichés sans lien.",
            file=sys.stderr,
        )
        for path in context.missing:
            print(f"  - {path}", file=sys.stderr)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
